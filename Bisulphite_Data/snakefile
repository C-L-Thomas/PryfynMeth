configfile: "config.yaml"

rule all:
	input:
              	expand('{sample}_1_bismark_bt2_pe.bam', sample=config["samples"]),
                expand('lambda.{sample}_1_bismark_bt2_pe.bam', sample=config["samples"]),
                expand('{sample}_1_bismark_bt2_pe.deduplicated.bam', sample=config["samples"]),
                expand('{sample}_1_bismark_bt2_pe.deduplicated.bismark.cov.gz', sample=config["samples"]),
                expand('{sample}.CpG_report.stranded.merged.cov', sample=config["samples"]),
                expand('{sample}.CpG_report.destranded.merged.cov', sample=config["samples"])

rule alignment:
    input:
        read1="{sample}_1.fq.gz",
        read2="{sample}_2.fq.gz"
    output:
	"{sample}_1_bismark_bt2_pe.bam"
    shell:
	"""
        module load gcc
        module load bowtie2
        module load samtools
        Bismark-0.24.2/bismark \
        --multicore 4 --genome /Genome_Folder/ -1 {input.read1} -2 {input.read2}
        """

rule lambda_alignment:
    input:
	read1="{sample}_1.fq.gz",
        read2="{sample}_2.fq.gz"
    output:
	"lambda.{sample}_1_bismark_bt2_pe.bam"
    shell:
	"""
	module load gcc
        module load bowtie2
        module load samtools
        /Bismark-0.24.2/bismark \
        --multicore 4 --genome /Lambda_Genome_Folder/ --prefix lambda -1 {input.read1} -2 {input.read2}
        """

rule deduplication:
    input:
	"{sample}_1_bismark_bt2_pe.bam"
    output:
	"{sample}_1_bismark_bt2_pe.deduplicated.bam"
    shell:
	"""
        module load gcc
        module load bowtie2
        module load samtools
        /Bismark-0.24.2/deduplicate_bismark -p --bam {input}
        """
rule meth_extraction:
    input:
        "{sample}_1_bismark_bt2_pe.deduplicated.bam"
    output:
        "{sample}_1_bismark_bt2_pe.deduplicated.bismark.cov.gz"
    shell:
        """
	module load gcc
        module load bowtie2
        module load samtools
        /Bismark-0.24.2/bismark_methylation_extractor \
        --no_overlap --comprehensive --merge_non_CpG --bedgraph --report --cytosine_report \
        --genome_folder /Genome_Folder/ {input}
        """

rule merge_cpgs_stranded:
    input:
	"{sample}_1_bismark_bt2_pe.deduplicated.bismark.cov.gz"
    output:
        "{sample}.CpG_report.stranded.merged.cov"
    params:
        "{sample}"
    shell:
	"""
        module load gcc
        module load bowtie2
        module load samtools
        /Bismark-0.24.2/coverage2cytosine \
        -o {params} \
        --genome_folder /Genome_Folder/ {input}
        """

rule merge_cpgs_destranded:
    input:
        "{sample}_1_bismark_bt2_pe.deduplicated.bismark.cov.gz"
    output:
        "{sample}.CpG_report.destranded.merged.cov"
    params:
        "{sample}"
    shell:
	"""
        module load gcc
        module load bowtie2
        module load samtools
        /Bismark-0.24.2/coverage2cytosine \
        -o {params} --merge_CpG \
        --genome_folder /Genome_Folder/ {input}
        """
